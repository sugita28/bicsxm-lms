# ============================================================
# LMS Frontend — Environment Variables
# Copy to .env or .env.local before running
# ============================================================

# Base URL for API requests.
# In development, leave blank or set to /api to use the Vite reverse proxy (defined in vite.config.js).
# In production, set to your API domain (e.g. https://api.lms.domain.com/api or /api if behind Nginx).
VITE_API_BASE_URL=/api
